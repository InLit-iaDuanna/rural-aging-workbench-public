# Frontend proxy; the backend must be reachable from the Sites runtime over HTTPS.
BUSINESS_API_URL=http://127.0.0.1:4100
# Independent backend. Use an operator-managed secret store in production.
DATABASE_URL=postgresql://xiangzhu:CHANGE_ME@localhost:5432/xiangzhu
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000
MATERIALS_DIR=work/materials
PORT=4100
HOST=127.0.0.1
CODEBUDDY_BIN=codebuddy
CODEX_BIN=codex
# Only for creating the initial account; remove after bootstrap.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=

# Tencent Maps: server only. Never use a VITE_ or NEXT_PUBLIC_ prefix.
TENCENT_MAP_KEY=
TENCENT_MAP_SK=
CODEBUDDY_MODEL=glm-5.3-flash
CLI_EFFORT=minimal
CLI_THINKING_TOKENS=1024
KNOWLEDGE_PATH=work/knowledge.json
# Explicit multimodal executor for private street photos.
CODEBUDDY_VISION_MODEL=hy3
