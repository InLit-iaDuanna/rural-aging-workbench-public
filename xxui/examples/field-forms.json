{
  "feedback": {
    "showQuestionNumbers": "off",
    "completeText": "保存记录",
    "questionErrorLocation": "bottom",
    "widthMode": "responsive",
    "title": "村民反馈",
    "elements": [
      {
        "type": "comment",
        "name": "text",
        "title": "原话或原意记录",
        "isRequired": true
      },
      {
        "type": "text",
        "name": "location",
        "title": "位置描述",
        "isRequired": true
      },
      {
        "type": "text",
        "name": "road_id",
        "title": "关联道路编号（可在地图选择）"
      },
      {
        "type": "radiogroup",
        "name": "consent",
        "title": "资料授权",
        "choices": [
          {
            "value": "pending",
            "text": "待确认"
          },
          {
            "value": "allowed",
            "text": "已获允许"
          },
          {
            "value": "withdrawn",
            "text": "已撤回"
          }
        ],
        "defaultValue": "pending"
      },
      {
        "type": "boolean",
        "name": "confirmed",
        "title": "已向反馈人确认原意和位置",
        "defaultValue": false
      },
      {
        "type": "boolean",
        "name": "allow_model",
        "title": "已获得向模型提供此条资料的允许",
        "defaultValue": false
      }
    ]
  },
  "observation": {
    "showQuestionNumbers": "off",
    "completeText": "保存记录",
    "questionErrorLocation": "bottom",
    "widthMode": "responsive",
    "title": "道路核查",
    "elements": [
      {
        "type": "text",
        "name": "issue_id",
        "title": "关联问题编号",
        "isRequired": true
      },
      {
        "type": "text",
        "name": "road_id",
        "title": "道路编号",
        "isRequired": true
      },
      {
        "type": "text",
        "name": "observed_at",
        "title": "观察时间",
        "inputType": "datetime-local",
        "isRequired": true
      },
      {
        "type": "text",
        "name": "source",
        "title": "观察人及资料来源",
        "isRequired": true
      },
      {
        "type": "dropdown",
        "name": "steps",
        "title": "台阶",
        "choices": [
          "未知",
          "有",
          "无"
        ],
        "defaultValue": "未知"
      },
      {
        "type": "dropdown",
        "name": "lit",
        "title": "照明",
        "choices": [
          "未知",
          "有",
          "无"
        ],
        "defaultValue": "未知"
      },
      {
        "type": "text",
        "name": "width",
        "title": "有效宽度（米，未测量留空）",
        "inputType": "number",
        "min": 0.1
      },
      {
        "type": "dropdown",
        "name": "access",
        "title": "通行条件",
        "choices": [
          "未知",
          "公开通行",
          "私人使用",
          "季节性通行",
          "条件通行",
          "不可通行"
        ],
        "defaultValue": "未知"
      },
      {
        "type": "boolean",
        "name": "confirmed",
        "title": "此条观察已完成核查",
        "defaultValue": false
      }
    ]
  },
  "facility": {
    "showQuestionNumbers": "off",
    "completeText": "保存记录",
    "questionErrorLocation": "bottom",
    "widthMode": "responsive",
    "title": "设施调查",
    "elements": [
      {
        "type": "boolean",
        "name": "confirmed",
        "title": "已核验设施信息",
        "defaultValue": false
      },
      {
        "type": "text",
        "name": "name",
        "title": "设施名称",
        "isRequired": true
      },
      {
        "type": "text",
        "name": "node_id",
        "title": "地图节点编号",
        "isRequired": true
      },
      {
        "type": "dropdown",
        "name": "kind",
        "title": "设施类型",
        "choices": [
          {
            "value": "seat",
            "text": "休息座椅"
          },
          {
            "value": "meal",
            "text": "助餐服务位"
          }
        ],
        "isRequired": true
      },
      {
        "type": "text",
        "name": "capacity",
        "title": "容量，未知留空",
        "inputType": "number",
        "min": 1
      },
      {
        "type": "text",
        "name": "opens",
        "title": "开放时间（相对模拟起点，秒）",
        "inputType": "number",
        "min": 0
      },
      {
        "type": "text",
        "name": "closes",
        "title": "关闭时间（秒）",
        "inputType": "number",
        "min": 0
      },
      {
        "type": "text",
        "name": "duration",
        "title": "单次使用时长（秒）",
        "inputType": "number",
        "min": 1
      },
      {
        "type": "text",
        "name": "source",
        "title": "信息来源",
        "isRequired": true
      }
    ]
  },
  "followup": {
    "showQuestionNumbers": "off",
    "completeText": "保存记录",
    "questionErrorLocation": "bottom",
    "widthMode": "responsive",
    "title": "行动回访",
    "elements": [
      {
        "type": "text",
        "name": "action_id",
        "title": "行动编号",
        "isRequired": true
      },
      {
        "type": "comment",
        "name": "text",
        "title": "现场情况及原反馈人意见",
        "isRequired": true
      },
      {
        "type": "radiogroup",
        "name": "result",
        "title": "处理结果",
        "choices": [
          {
            "value": "resolved",
            "text": "问题已解决"
          },
          {
            "value": "unresolved",
            "text": "尚未解决"
          },
          {
            "value": "reopen",
            "text": "需要重开"
          }
        ],
        "isRequired": true
      },
      {
        "type": "text",
        "name": "observed_at",
        "title": "回访时间",
        "inputType": "datetime-local",
        "isRequired": true
      }
    ]
  }
}